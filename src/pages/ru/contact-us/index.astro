---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Контакт - Эксперт по производству картофеля в Северном Китае",
  h1: "Контакт - Эксперт по производству картофеля в Северном Китае",
  description: "Мартин Ван",
  canonical: "/ru/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"ru\" href=\"https://dinweys.com/ru/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="ru" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>КОНТАКТ</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>Специалисты для связи</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>Мартин Ван</h3>
          <p style="margin-bottom:0.5rem"><strong>Адрес:</strong> #3 здание, Северная Силиконовая долина, Цяодунский район, Чжанцзякоу город, Хэбэй, Китай.</p>
          <p style="margin-bottom:0.5rem"><strong>Телефон | WhatsApp | Вичат:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>Электронная почта: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>Аарон.Ван</h3>
          <p style="margin-bottom:0.5rem"><strong>Телефон | WhatsApp | Вичат:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>Электронная почта: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
