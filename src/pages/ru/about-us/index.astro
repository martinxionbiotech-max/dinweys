<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="ru" ogImage="/images/Food-Factory-1-1024x700.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
