---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "ถั่ว - ผู้เชี่ยวชาญด้านการผลิตมันฝรั่งตอนเหนือของจีน",
  h1: "ถั่ว - ผู้เชี่ยวชาญด้านการผลิตมันฝรั่งตอนเหนือของจีน",
  description: "เลือกซื้อถั่ว Dinweys แบบเทกอง — ถั่วแดง ถั่วปากอ้า และถั่วจีนเหนือคุณภาพพรีเมียม พร้อมรองรับแพ็กเกจ OEM",
  canonical: "/th/beans/",
  author: " ",
  date: "2024-10-05",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/beans/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/beans/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/beans/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="th" author=" "  datePublished="2024-10-05" dateModified="2024-10-05">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<p></p>`} />
  </article>
</BaseLayout>
