---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "ติดต่อ - ผู้เชี่ยวชาญด้านการผลิตมันฝรั่งตอนเหนือของจีน",
  h1: "ติดต่อ - ผู้เชี่ยวชาญด้านการผลิตมันฝรั่งตอนเหนือของจีน",
  description: "มาร์ติน.วัง",
  canonical: "/th/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="th" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<h2 class="wp-block-heading has-text-align-center has-x-large-font-size"><strong>ติดต่อ</strong></h2><div class="wp-block-image"><figure class="aligncenter is-resized"><img src="/images/company-building-1-1024x598.jpg" decoding="async" width="1024" height="598" alt="Company Building" class="wp-image-209" style="width:575px;height:auto" title="ติดต่อารบริษัท" /><figcaption class="wp-element-caption"><strong>อาคารสำนักงานใหญ่</strong>: #3 อาคาร, นอร์ทซิลิคอนแวลลีย์, เขตเฉียวตง, เมืองจางเจียโข่ว, เหอเป่ย, จีน.</figcaption></figure></div><div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex"><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><h2 class="wp-block-heading"><strong>ผู้เชี่ยวชาญที่จะติดต่อ</strong></h2></div></div><div style="height:27px" aria-hidden="true" class="wp-block-spacer"></div><p class="wp-block-paragraph"><strong>มาร์ติน.วัง</strong></p><hr class="wp-block-separator alignwide has-alpha-channel-opacity"/><p class="has-medium-font-size wp-block-paragraph"><strong>ที่อยู่:</strong> #3 อาคาร, นอร์ทซิลิคอนแวลลีย์, เขตเฉียวตง, เมืองจางเจียโข่ว, เหอเป่ย, จีน.</p><p class="has-medium-font-size wp-block-paragraph"><strong>โทรศัพท์ | วอทส์แอพพ์ | วีแชท:</strong> +86 13323237275</p><p class="has-medium-font-size wp-block-paragraph" style="text-transform:none"><strong>อีเมล: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p><div style="height:112px" aria-hidden="true" class="wp-block-spacer"></div><p class="wp-block-paragraph"><strong>แอรอน</strong>.<strong>วัง</strong></p><hr class="wp-block-separator alignwide has-alpha-channel-opacity"/><p class="has-medium-font-size wp-block-paragraph"><strong>โทรศัพท์ | วอทส์แอพพ์ | วีแชท:</strong> +86 13313137465</p><p class="has-medium-font-size wp-block-paragraph" style="text-transform:none"><strong>อีเมล: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p><p class="wp-block-paragraph"></p>`} />
  </article>
</BaseLayout>
