---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "ติดต่อ - ผู้เชี่ยวชาญด้านการผลิตมันฝรั่งตอนเหนือของจีน",
  h1: "ติดต่อ - ผู้เชี่ยวชาญด้านการผลิตมันฝรั่งตอนเหนือของจีน",
  description: "มาร์ติน.วัง",
  canonical: "/th/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="th" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>ติดต่อ</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>ผู้เชี่ยวชาญที่จะติดต่อ</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>มาร์ติน.วัง</h3>
          <p style="margin-bottom:0.5rem"><strong>ที่อยู่:</strong> #3 อาคาร, นอร์ทซิลิคอนแวลลีย์, เขตเฉียวตง, เมืองจางเจียโข่ว, เหอเป่ย, จีน.</p>
          <p style="margin-bottom:0.5rem"><strong>โทรศัพท์ | วอทส์แอพพ์ | วีแชท:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>อีเมล: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>แอรอน.วัง</h3>
          <p style="margin-bottom:0.5rem"><strong>โทรศัพท์ | วอทส์แอพพ์ | วีแชท:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>อีเมล: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
