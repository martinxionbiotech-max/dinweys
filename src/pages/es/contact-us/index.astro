---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Contacto - Experto en producción de patatas en el norte de China",
  h1: "Contacto - Experto en producción de patatas en el norte de China",
  description: "martin.wang",
  canonical: "/es/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"es\" href=\"https://dinweys.com/es/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="es" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>CONTACTO</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>Especialistas para contactar</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>martin.wang</h3>
          <p style="margin-bottom:0.5rem"><strong>DIRECCIÓN:</strong> #3 edificio, Valle del Silicio Norte, Distrito de Qiaodong, Ciudad de Zhangjiakou, Hebei, Porcelana.</p>
          <p style="margin-bottom:0.5rem"><strong>Teléfono | WhatsApp | WeChat:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>Correo electrónico: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>Aarón.Wang</h3>
          <p style="margin-bottom:0.5rem"><strong>Teléfono | WhatsApp | WeChat:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>Correo electrónico: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
