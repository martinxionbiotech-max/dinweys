const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "¿Qué beneficios funcionales aportan los copos de patata en la fabricación de alimentos??", "acceptedAnswer": {"@type": "Answer", "text": "Los copos de patata ofrecen una excelente absorción de agua., sabor a patata natural, color atractivo después de la reacción de Maillard, y un perfil nutricional completo, haciéndolos ideales para bocadillos, panadería, y productos compuestos."}}, {"@type": "Question", "name": "¿En qué se diferencian los gránulos de patata de los copos en cuanto a su rendimiento funcional??", "acceptedAnswer": {"@type": "Answer", "text": "Los gránulos están completamente gelatinizados., produce texturas más suaves cuando se rehidrata, y se utilizan principalmente para productos instantáneos de puré de papa., mientras que los copos están parcialmente cocidos y sirven principalmente como ingrediente para aplicaciones mezcladas.."}}, {"@type": "Question", "name": "¿Puede el almidón de patata mejorar la textura de salsas y rellenos??", "acceptedAnswer": {"@type": "Answer", "text": "Sí, el almidón de patata proporciona espesamiento, gelificar, y propiedades vinculantes, mejorando la viscosidad, sensación en boca, y estabilidad en sopas, salsas, y rellenos a base de carne."}}, {"@type": "Question", "name": "¿Cuál es el papel de la fibra de patata en los alimentos procesados??", "acceptedAnswer": {"@type": "Answer", "text": "La fibra de patata mejora la retención de humedad., mejora la textura y la estructura, y agrega fibra dietética, que es útil en productos cárnicos, panadería, y alternativas a base de plantas."}}, {"@type": "Question", "name": "¿Cómo contribuyen los ingredientes de la papa a la vida útil y la eficiencia del procesamiento??", "acceptedAnswer": {"@type": "Answer", "text": "Los ingredientes de la papa retienen la humedad., estabilizar texturas, y reducir las pérdidas por cocción, lo que lleva a una vida útil más larga, calidad constante del producto, y fabricación rentable."}}]};
