---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "接觸 - 中國北方馬鈴薯生產專家",
  h1: "接觸 - 中國北方馬鈴薯生產專家",
  description: "王馬丁",
  canonical: "/zh-tw/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"zh-tw\" href=\"https://dinweys.com/zh-tw/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="zh-TW" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>接觸</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>聯繫專家</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>王馬丁</h3>
          <p style="margin-bottom:0.5rem"><strong>地址:</strong> #3 建築, 北矽谷, Qiaodong District, Zhangjiakou City, hebei, 中國.</p>
          <p style="margin-bottom:0.5rem"><strong>電話 | WhatsApp | 微信:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>電子郵件: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>亞倫.王</h3>
          <p style="margin-bottom:0.5rem"><strong>電話 | WhatsApp | 微信:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>電子郵件: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
