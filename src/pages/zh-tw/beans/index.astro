---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "豆子 - 中國北方馬鈴薯生產專家",
  h1: "豆子 - 中國北方馬鈴薯生產專家",
  description: "瀏覽 Dinweys 散裝豆類——紅芸豆、蠶豆等優質華北豆類，支持 OEM 包裝，面向進口商與食品製造商批量供應。",
  canonical: "/zh-tw/beans/",
  author: " ",
  date: "2024-10-05",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"zh-tw\" href=\"https://dinweys.com/zh-tw/beans/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/beans/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/beans/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="zh-TW" author=" "  datePublished="2024-10-05" dateModified="2024-10-05">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<p></p>`} />
  </article>
</BaseLayout>
