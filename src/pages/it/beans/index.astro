---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Beans - Esperto nella produzione di patate della Cina settentrionale",
  h1: "Beans - Esperto nella produzione di patate della Cina settentrionale",
  description: "Scopri i fagioli Dinweys sfusi — fagioli rossi, fave e altri legumi della Cina settentrionale, forniti sfusi con supporto per imballaggi OEM.",
  canonical: "/it/beans/",
  author: " ",
  date: "2024-10-05",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"it\" href=\"https://dinweys.com/it/beans/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/beans/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/beans/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="it" author=" "  datePublished="2024-10-05" dateModified="2024-10-05">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<p></p>`} />
  </article>
</BaseLayout>
