const gallery = ["/images/dinweys-brown-flaxseed-scaled.jpg"];
const related = [{"name": "Hulled Flaxseed in Bulk Top Manufacturer OEM Supply", "href": "/dinweys-flaxseed-kernels-oem-support/", "image": "/images/flaxseed-kernels-300x300.jpg"}, {"name": "Flaxseed Hull (Linseed Hull) in Bulk Manufacturer Direct Sale", "href": "/bulk-flaxseed-hulls-linseed-2025-new/", "image": "/images/flaxseeds-linseed-hulls-2-300x300.jpg"}, {"name": "Flaxseed Meal Bulk OEM Package Manufacturer Direct", "href": "/flaxseed-meal-bulk/", "image": "/images/flaxseed-meal-bulk-300x300.jpg"}, {"name": "Flaxseed Gum Powder 55% Purity Manufacturer Direct", "href": "/flaxseed-gum-powder-55-purity-manufacturer-direct/", "image": "/images/flaxseed-gum-5-scaled-300x300.jpg"}];
