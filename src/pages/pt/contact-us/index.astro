---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Contato - Especialista em produção de batata no norte da China",
  h1: "Contato - Especialista em produção de batata no norte da China",
  description: "Martin.Wang",
  canonical: "/pt/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"pt\" href=\"https://dinweys.com/pt/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="pt" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
