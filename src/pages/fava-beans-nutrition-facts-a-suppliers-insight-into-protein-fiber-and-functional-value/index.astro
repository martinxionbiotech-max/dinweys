const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Are fava beans a good source of protein?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Fava beans are considered a high-protein legume. Dried fava beans typically contain 20–25 g of protein per 100 g, and in some varieties protein content can approach 30% on a dry matter basis. This makes them an excellent plant-based protein source, especially for vegetarian and vegan diets."}}, {"@type": "Question", "name": "How much protein is in fresh vs dried fava beans?", "acceptedAnswer": {"@type": "Answer", "text": "Fresh fava beans usually contain 8–10 g of protein per 100 g, while dried fava beans are much more concentrated, providing 20–25 g per 100 g due to lower moisture content. This is why dried fava beans are preferred in food manufacturing and bulk supply."}}, {"@type": "Question", "name": "Are fava beans high in dietary fiber?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Fava beans contain approximately 5–11 g of dietary fiber per 100 g, which supports digestive health, helps regulate cholesterol levels, and contributes to satiety. Their fiber content is one reason they are widely used in functional and health-oriented food products."}}, {"@type": "Question", "name": "What vitamins are found in fava beans?", "acceptedAnswer": {"@type": "Answer", "text": "Fava beans are rich in B-complex vitamins, including vitamin B1, B2, B6, and folate (vitamin B9). They also provide vitamin C and vitamin K, which play important roles in metabolism, red blood cell formation, immune function, and bone health."}}, {"@type": "Question", "name": "What minerals do fava beans contain?", "acceptedAnswer": {"@type": "Answer", "text": "Fava beans contain several essential minerals such as calcium, iron, potassium, magnesium, phosphorus, and zinc. These minerals support bone health, oxygen transport in the blood, electrolyte balance, immune function, and overall metabolic health."}}, {"@type": "Question", "name": "Do fava beans contain antioxidants?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Fava beans contain polyphenols and flavonoids, which are antioxidant compounds that help neutralize free radicals and may reduce the risk of chronic diseases, including cardiovascular and metabolic disorders."}}, {"@type": "Question", "name": "Are fava beans low in fat?", "acceptedAnswer": {"@type": "Answer", "text": "Fava beans are naturally low in fat, making them suitable for low-fat diets and heart-health-focused food formulations. Their nutritional profile combines high protein, high fiber, and low fat, which is particularly attractive in plant-based food development."}}, {"@type": "Question", "name": "Are fava beans suitable for food manufacturing and industrial use?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. From a supplier’s perspective, dried fava beans are widely used in plant protein production, functional foods, snacks, and bulk ingredient applications due to their stable nutritional composition, high protein density, and good processing performance."}}, {"@type": "Question", "name": "Do fava beans contain any special bioactive compounds?", "acceptedAnswer": {"@type": "Answer", "text": "Fava beans naturally contain compounds such as choline, phospholipids, and L-DOPA (levodopa). L-DOPA is involved in dopamine synthesis and is one of the reasons fava beans are of scientific and nutritional interest."}}, {"@type": "Question", "name": "Why is supplier quality important when evaluating fava beans nutrition facts?", "acceptedAnswer": {"@type": "Answer", "text": "Nutrition values are only reliable when the supply is consistent. Factors such as harvest maturity, drying method, moisture control, and storage conditions directly affect protein, fiber, and mineral stability. A reliable supplier ensures batch-to-batch nutritional consistency."}}]};
