const related = [{"name": "Dinweys Potato Flour (Mashed Potato Flakes)", "href": "/dinweys-potato-flour-mashed-potato-flakes/", "image": "/images/potato-flour-scaled-300x300.jpg"}, {"name": "Chinese French Fries Crinkle Cut Manufacturer Direct Bulk Sale", "href": "/chinese-french-fries-crinkle-cut/", "image": "/images/french-fries-crinkle-cut1-2-300x300.jpg"}, {"name": "1/4 French Fries McCain in Bulk \u2013 Manufacturer Direct", "href": "/1-4-french-fries-mccain-in-bulk-manufacturer-direct/", "image": "/images/21-scaled-300x300.jpg"}, {"name": "Dinweys Bulk Potato Flakes", "href": "/dinweys-bulk-potato-flakes/", "image": "/images/Dinweys-Potato-flakes-scaled-300x300.jpg"}];
