};
const hreflang = "<link rel=\\\"alternate\\\" hreflang=\\\"en\\\" href=\\\"https://dinweys.com/products/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"x-default\\\" href=\\\"https://dinweys.com/products/\\\" />";
const items = [{"name": "1/4 French Fries McCain in Bulk – Manufacturer Direct", "href": "/1-4-french-fries-mccain-in-bulk-manufacturer-direct/", "image": "/images/21.jpg"}, {"name": "Bulk Red Kidney Beans Good Quality – Dinweys Supply", "href": "/red-kidney-beans/", "image": "/images/red-kidney-bean.jpg"}, {"name": "China Buckwheat Manufacturer Supply in Bulk", "href": "/china-buckwheat-manufacturer-supply-in-bulk/", "image": "/images/China-Buckwheat-2.jpg"}, {"name": "Chinese French Fries Crinkle Cut Manufacturer Direct Bulk Sale", "href": "/chinese-french-fries-crinkle-cut/", "image": "/images/french-fries-crinkle-cut1-2.jpg"}, {"name": "Dinweys Bulk Brown Flaxseed", "href": "/dinweys-bulk-brown-flaxseed/", "image": "/images/dinweys-brown-flaxseed.jpg"}, {"name": "Dinweys Bulk Potato Flakes", "href": "/dinweys-bulk-potato-flakes/", "image": "/images/Dinweys-Potato-flakes.jpg"}, {"name": "Dinweys Bulk Quinoa Rice 1st Grade Good Quality", "href": "/dinweys-bulk-quinoa/", "image": "/images/Quinoa-product1.jpg"}, {"name": "DinWeys Bulk sunflower kernels", "href": "/bulk-sunflower-kernels/", "image": "/images/sunflower-kernels.jpg"}, {"name": "Dinweys Dried Fava Bean in Bulk (Broad Bean) New Production", "href": "/dinweys-bulk-broad-bean-new-production/", "image": "/images/微信图片_20241027134846.jpg"}, {"name": "Dinweys Potato Flour (Mashed Potato Flakes)", "href": "/dinweys-potato-flour-mashed-potato-flakes/", "image": "/images/potato-flour.jpg"}, {"name": "DinWeys Selected black Sesame", "href": "/selected-black-sesame/", "image": "/images/Dinweys-Black-Sesome-processing.jpg"}, {"name": "Flaxseed Gum Powder 55% Purity Manufacturer Direct", "href": "/flaxseed-gum-powder-55-purity-manufacturer-direct/", "image": "/images/flaxseed-gum-5.jpg"}, {"name": "Flaxseed Hull (Linseed Hull) in Bulk Manufacturer Direct Sale", "href": "/bulk-flaxseed-hulls-linseed-2025-new/", "image": "/images/flaxseeds-linseed-hulls-2.jpg"}, {"name": "Flaxseed Meal Bulk OEM Package Manufacturer Direct", "href": "/flaxseed-meal-bulk/", "image": "/images/flaxseed-meal-bulk.jpg"}, {"name": "Hulled Flaxseed in Bulk Top Manufacturer OEM Supply", "href": "/dinweys-flaxseed-kernels-oem-support/", "image": "/images/flaxseed-kernels.jpg"}, {"name": "Instant Sweet Potatoes Flakes (Snow Flakes) Premium 20kg Bag", "href": "/instant-sweet-potatoes-flakes-snow-flakes-premium-20kg-bag/", "image": "/images/Instant-Sweet-Potatoes-Flakes-2.jpg"}, {"name": "Milk Thistle Seed Bulk North China Production", "href": "/milk-thistle-seed-bulk-north-china-production/", "image": "/images/milk-thistle-seed-3.jpg"}];
---

<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" ogImage="/images/Dinweys-Potato-flakes-1-1024x1024.jpg">
  <div class="container section">
    <span class="kicker">Products</span>
    <h1 class="sec-title">{page.title}</h1>
    <div class="card-grid">
      {items.map((item) => (
        <div class="card">
          {item.image && (
            <div class="thumb">
              <a href={item.href}><img src={item.image} alt={item.name} loading="lazy" /></a>
            </div>
          )}
          <div class="body">
            <h3><a href={item.href}>{item.name}</a></h3>
            <a class="link" href={item.href}>Read more →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
