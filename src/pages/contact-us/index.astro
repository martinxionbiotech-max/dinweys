---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Contact",
  h1: "Contact",
  description: "Martin.Wang",
  canonical: "/contact-us/",
  author: "",
  date: "",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"zh\" href=\"https://dinweys.com/zh/contact-us/\" /> <link rel=\"alternate\" hreflang=\"zh-tw\" href=\"https://dinweys.com/zh-tw/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ar\" href=\"https://dinweys.com/ar/contact-us/\" /> <link rel=\"alternate\" hreflang=\"fr\" href=\"https://dinweys.com/fr/contact-us/\" /> <link rel=\"alternate\" hreflang=\"de\" href=\"https://dinweys.com/de/contact-us/\" /> <link rel=\"alternate\" hreflang=\"it\" href=\"https://dinweys.com/it/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ja\" href=\"https://dinweys.com/ja/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ko\" href=\"https://dinweys.com/ko/contact-us/\" /> <link rel=\"alternate\" hreflang=\"pt\" href=\"https://dinweys.com/pt/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ru\" href=\"https://dinweys.com/ru/contact-us/\" /> <link rel=\"alternate\" hreflang=\"es\" href=\"https://dinweys.com/es/contact-us/\" /> <link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" ogImage="/images/company-building-1.jpg">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>CONTACT</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>Specialists to Contact</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>Martin.Wang</h3>
          <p style="margin-bottom:0.5rem"><strong>Address:</strong> #3 building, North Silicon Valley, Qiaodong District, Zhangjiakou City, Hebei, China.</p>
          <p style="margin-bottom:0.5rem"><strong>Phone | WhatsApp | WeChat:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>Email: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>Aaron.Wang</h3>
          <p style="margin-bottom:0.5rem"><strong>Phone | WhatsApp | WeChat:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>Email: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
