---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Contact",
  h1: "Contact",
  description: "Martin.Wang",
  canonical: "/contact-us/",
  author: "",
  date: "",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"zh\" href=\"https://dinweys.com/zh/contact-us/\" /> <link rel=\"alternate\" hreflang=\"zh-tw\" href=\"https://dinweys.com/zh-tw/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ar\" href=\"https://dinweys.com/ar/contact-us/\" /> <link rel=\"alternate\" hreflang=\"fr\" href=\"https://dinweys.com/fr/contact-us/\" /> <link rel=\"alternate\" hreflang=\"de\" href=\"https://dinweys.com/de/contact-us/\" /> <link rel=\"alternate\" hreflang=\"it\" href=\"https://dinweys.com/it/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ja\" href=\"https://dinweys.com/ja/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ko\" href=\"https://dinweys.com/ko/contact-us/\" /> <link rel=\"alternate\" hreflang=\"pt\" href=\"https://dinweys.com/pt/contact-us/\" /> <link rel=\"alternate\" hreflang=\"ru\" href=\"https://dinweys.com/ru/contact-us/\" /> <link rel=\"alternate\" hreflang=\"es\" href=\"https://dinweys.com/es/contact-us/\" /> <link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="article" ogImage="/images/company-building-1.jpg">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<h2 class="wp-block-heading has-text-align-center has-x-large-font-size"><strong>CONTACT</strong></h2><div class="wp-block-image"><figure class="aligncenter is-resized"><img src="/images/company-building-1-1024x598.jpg" decoding="async" width="1024" height="598" alt="Company Building" class="wp-image-209" style="width:575px;height:auto" title="Contact 2" /><figcaption class="wp-element-caption"><strong>Head-office Building</strong>: #3 building, North Silicon Valley, Qiaodong District, Zhangjiakou City, Hebei, China.</figcaption></figure></div><div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex"><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><h2 class="wp-block-heading"><strong>Specialists to Contact</strong></h2></div></div><div style="height:27px" aria-hidden="true" class="wp-block-spacer"></div><p class="wp-block-paragraph"><strong>Martin.Wang</strong></p><hr class="wp-block-separator alignwide has-alpha-channel-opacity"/><p class="has-medium-font-size wp-block-paragraph"><strong>Address:</strong> #3 building, North Silicon Valley, Qiaodong District, Zhangjiakou City, Hebei, China.</p><p class="has-medium-font-size wp-block-paragraph"><strong>Phone | WhatsApp | WeChat:</strong> +86 13323237275</p><p class="has-medium-font-size wp-block-paragraph" style="text-transform:none"><strong>Email: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p><div style="height:112px" aria-hidden="true" class="wp-block-spacer"></div><p class="wp-block-paragraph"><strong>Aaron</strong>.<strong>Wang</strong></p><hr class="wp-block-separator alignwide has-alpha-channel-opacity"/><p class="has-medium-font-size wp-block-paragraph"><strong>Phone | WhatsApp | WeChat:</strong> +86 13313137465</p><p class="has-medium-font-size wp-block-paragraph" style="text-transform:none"><strong>Email: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p><p class="wp-block-paragraph"></p>`} />
  </article>
</BaseLayout>
