---
import BaseLayout from "../layouts/BaseLayout.astro";

const page = {
  title: "Global Manufacturer of Premium Potato Products",
  h1: "Global Manufacturer of Premium Potato Products",
  description: "North China core potato products Manufacturer and Supplier, supplying high-quality Potato Flakes, French Fries, Starch",
  canonical: "/",
  author: "",
  date: "",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"zh\" href=\"https://dinweys.com/zh/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"zh-tw\" href=\"https://dinweys.com/zh-tw/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"ar\" href=\"https://dinweys.com/ar/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"fr\" href=\"https://dinweys.com/fr/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"de\" href=\"https://dinweys.com/de/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"it\" href=\"https://dinweys.com/it/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"ja\" href=\"https://dinweys.com/ja/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"ko\" href=\"https://dinweys.com/ko/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"pt\" href=\"https://dinweys.com/pt/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"ru\" href=\"https://dinweys.com/ru/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"es\" href=\"https://dinweys.com/es/dinweys.com/\" /> <link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/dinweys.com/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <h1>Global Manufacturer of Premium Potato-Based Ingredients</h1>
      <p class="lead"><em>Specializing in Potato Flakes, Starches, Flours, and Frozen Fries</em></p>
      <div class="hero-actions">
        <a class="btn" href="/products/">Our Products</a>
        <a class="btn outline" href="/contact-us/">Get a Quote</a>
      </div>
    </div>
  </section>

  <div class="container">
    <article class="page-content">
      <!-- Factory banner -->
      <section class="section">
        <img src="/images/Food-Factory1-1024x456.jpg" fetchpriority="high" decoding="async" width="1024" height="456" alt="food materials processing line" style="object-position:55% 85%" />
      </section>

      <!-- Tagline -->
      <section class="section" style="padding-top:0">
        <h2 class="section-title" style="text-align:center;color:var(--primary-dark)">High-quality Potato Flakes, French Fries, Starch Manufacturer and Supplier</h2>
      </section>

      <!-- Potato field -->
      <img src="/images/Dinweys-potato-field.jpg" decoding="async" width="893" height="192" alt="potato materials field" />

      <!-- Our Advantages -->
      <h2 class="section-title" style="text-align:center" id="our-advantages">OUR ADVANTAGES</h2>
      <div class="table-wrap">
        <table class="data-table">
          <tbody>
            <tr><td><strong>Location &amp; Raw Material</strong></td><td>Located in Hebei, China: Positioned within the <strong>41° N latitude Potato Growing Zone</strong>, offering a climate and vast geographical area ideal for superior potato cultivation. Proximity to major high-quality potato planting bases and key export ports.</td></tr>
            <tr><td><strong>Technical Advantage</strong></td><td>Expertise in Potato Deep Processing: Led by top Chinese food industry experts specializing in potato ingredient functional development and process engineering. We utilize the <strong>most advanced production lines</strong> to guarantee product processing quality and consistency.</td></tr>
            <tr><td><strong>Quality &amp; Compliance</strong></td><td><strong>Comprehensive Certifications:</strong> We hold complete product qualification and safety systems, including <strong>ISO, HACCP, BRC, Halal</strong>, etc., ensuring global regulatory compliance. We maintain <strong>excellent production workers and food engineers</strong>, supported by <strong>perfect testing equipment and laboratories</strong> to guarantee stable and superior product quality.</td></tr>
            <tr><td><strong>Supply Chain &amp; Capacity</strong></td><td><strong>Abundant Capacity:</strong> Our sufficient and stable production capacity can meet the diverse requirements of large international buyers and procurement orders.</td></tr>
            <tr><td><strong>Service &amp; Partnership</strong></td><td>Proficient English Communication &amp; Flexible OEM: Comprehensive support for global clients, including private label customization for potato flakes and fries.</td></tr>
            <tr><td><strong>Client Endorsement</strong></td><td>Clients include well-known global brands (Pepsi China, Orion, Dali, Unify Thailand). Stable quality and timely supply are proven.</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Core Products -->
      <h2 class="section-title" style="text-align:center;color:var(--primary);text-transform:uppercase" id="food-materials-product-range">Our Core Potato Products Portfolio</h2>
      <div class="card-grid">
        <div class="card">
          <img src="/images/Dinweys-Potato-flakes-1024x1024.jpg" decoding="async" width="1024" height="1024" alt="Potato Flakes" />
          <h3 style="text-align:center">Potato Flakes</h3>
          <p>From standard to high-grade varieties, our potato flakes are designed to meet diverse industry needs.</p>
          <p>Backed by <strong>FSSC certification</strong>, we have a strong global export track record.</p>
          <p>We specialize in <strong>OEM solutions</strong>, allowing us to customize specifications to your exact requirements.</p>
        </div>
        <div class="card">
          <img src="/images/Dinweys-french-fries.jpg" decoding="async" width="632" height="632" alt="Frozen French Fries" />
          <h3 style="text-align:center">Frozen French Fries</h3>
          <p>Our ISO-certified facility produces high-quality frozen French fries available in <strong>various cuts and sizes</strong>.</p>
          <p>We pride ourselves on flexibility, offering <strong>bespoke OEM services</strong> to align perfectly with your brand and customer preferences.</p>
        </div>
        <div class="card">
          <img src="/images/potato-starch-1024x1024.jpg" decoding="async" width="1024" height="1024" alt="Potato Starch" />
          <h3 style="text-align:center">Potato Starch</h3>
          <p>Engineered for versatility, our potato starch is a <strong>Grade A product</strong> produced in strict accordance with Chinese National Standards.</p>
          <p>Its superior quality makes it the ideal choice for applications across multiple sectors, ensuring consistency and performance.</p>
        </div>
      </div>

      <!-- Bottom field -->
      <img src="/images/Dinweys-potato-field1-1024x168.jpg" decoding="async" width="1024" height="168" alt="Food materials | raw potatoes" style="width:100%;margin-top:2rem" />
    </article>
  </div>

  <!-- Contact CTA -->
  <section class="cta-band" style="border-radius:0;margin:3rem 0 0">
    <div class="container">
      <h2 style="text-align:center">Please Feel Free to Contact Us</h2>
      <p style="color:#fff"><strong>Address:</strong>&nbsp;#3, building North Silicon Valley, Qiaodong District, Zhangjiakou City, China.</p>
      <p style="color:#fff"><strong>Phone | WhatsApp | WeChat:</strong>&nbsp;+86 13323237275</p>
      <p style="color:#fff"><strong>Email:</strong>&nbsp;<a href="mailto:martin@dinweys.com" style="color:#fff">martin@dinweys.com</a></p>
      <p style="color:rgba(255,255,255,0.8)"><strong>Chinese Site</strong>: <a href="https://www.dinweys.cn/" rel="nofollow noopener" target="_blank" style="color:#fff">dinweys.cn</a></p>
    </div>
  </section>
</BaseLayout>
