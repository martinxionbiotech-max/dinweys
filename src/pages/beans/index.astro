---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "Beans Products",
  description: "Dinweys Beans Products include: Soybean (Glycine max) Peanut / Groundnut (Arachis hypogaea) Cowpea (Vigna unguiculata) Mung Bean (Vigna radiata) Red Bean / Adzuki Bean (Vigna angularis) Rice Bean (Vigna umbellata) Hyacinth Bean (Lablab purpureus) (Note: This is not the flat bean from the Pisum genus but from the Lablab genus) Pea / Snow Pea / Field Pea (Pisum sativum) Fava Bean / Broad Bean (Vicia faba) Lentil (Lens culinaris)",
  canonical: "/beans/",
};
const hreflang = "<link rel=\\\"alternate\\\" hreflang=\\\"en\\\" href=\\\"https://dinweys.com/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"x-default\\\" href=\\\"https://dinweys.com/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"zh\\\" href=\\\"https://dinweys.com/zh/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"zh-tw\\\" href=\\\"https://dinweys.com/zh-tw/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"ar\\\" href=\\\"https://dinweys.com/ar/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"fr\\\" href=\\\"https://dinweys.com/fr/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"de\\\" href=\\\"https://dinweys.com/de/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"it\\\" href=\\\"https://dinweys.com/it/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"ja\\\" href=\\\"https://dinweys.com/ja/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"ko\\\" href=\\\"https://dinweys.com/ko/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"pt\\\" href=\\\"https://dinweys.com/pt/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"ru\\\" href=\\\"https://dinweys.com/ru/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"es\\\" href=\\\"https://dinweys.com/es/beans/\\\" /> <link rel=\\\"alternate\\\" hreflang=\\\"th\\\" href=\\\"https://dinweys.com/th/beans/\\\" />";
const items = [{"name": "Bulk Red Kidney Beans Good Quality – Dinweys Supply", "href": "/red-kidney-beans/", "image": "/images/red-kidney-bean-scaled.jpg"}, {"name": "Dinweys Dried Fava Bean in Bulk (Broad Bean) New Production", "href": "/dinweys-bulk-broad-bean-new-production/", "image": "/images/微信图片_20241027134846-scaled.jpg"}];
---

<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" ogImage="">
  <div class="container section">
    <span class="kicker">Products</span>
    <h1 class="sec-title">{page.title}</h1>
    <div class="card-grid">
      {items.map((item) => (
        <div class="card">
          {item.image && (
            <div class="thumb">
              <a href={item.href}><img src={item.image} alt={item.name} loading="lazy" /></a>
            </div>
          )}
          <div class="body">
            <h3><a href={item.href}>{item.name}</a></h3>
            <a class="link" href={item.href}>Read more →</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</BaseLayout>
