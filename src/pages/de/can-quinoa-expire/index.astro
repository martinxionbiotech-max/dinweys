<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="article" lang="de" ogImage="/images/quinoa.jpg" author="Martin.Wang"  datePublished="2024-09-01" dateModified="2024-09-01">
