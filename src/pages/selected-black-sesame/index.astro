---
import ProductLayout from "../../layouts/ProductLayout.astro";

const page = {
  title: "DinWeys Selected black Sesame",
  description: "Our black sesame with its thin skin, rich black color, high oil content, and crisp texture. Packed with potassium, unsaturated fatty acids, and vitamin E.",
  canonical: "/selected-black-sesame/",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/selected-black-sesame/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/selected-black-sesame/\" />";
