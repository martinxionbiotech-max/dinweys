---
import ProductLayout from "../../layouts/ProductLayout.astro";

const page = {
  title: "DinWeys Selected black Sesame",
  description: "Our black sesame with its thin skin, rich black color, high oil content, and crisp texture. Packed with potassium, unsaturated fatty acids, and vitamin E.",
  canonical: "/selected-black-sesame/",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/selected-black-sesame/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/selected-black-sesame/\" />";
const gallery = ["/images/Dinweys-Black-Sesome-processing.jpg", "/images/DinWeys-black-sesame.jpg"];
const related = [];
const category = "Sesame Series";
const price = "$2.85";
---
<ProductLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogImage="/images/Dinweys-Black-Sesome-processing.jpg" gallery={gallery} category={category} price={price} related={related} descriptionHtml={`<p>Our black sesame, with its thin skin, rich black color, high oil content, and crisp texture, is good for food processing and bakery.</p><h3>Key Indicators of Black Sesame</h3><table><thead><tr><th>Indicator</th><th>Premium Standard</th></tr></thead><tbody><tr><td>Kernel Purity Rate</td><td>≥99.99%</td></tr><tr><td>Impurity Content</td><td>≤1.0%</td></tr><tr><td>Moisture Content</td><td>≤7%</td></tr><tr><td>Oil Content</td><td>≥50.0%</td></tr><tr><td>Color and Odor</td><td>Jet black, bright, normal smell, with a unique aroma</td></tr><tr><td>Acid Value</td><td>≤5 mgKOH/g</td></tr><tr><td>Peroxide Value</td><td>≤0.3%</td></tr><tr><td>Heavy Metal Content</td><td>Meets national standards, such as arsenic and lead</td></tr></tbody></table>`} />
