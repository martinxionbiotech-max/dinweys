          <img src="/images/Food-Factory-1.jpg" decoding="async" alt="ジャガイモ加工ライン" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">ジャガイモ加工ライン</figcaption>
