        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/office-1024x768.jpg" decoding="async" alt="私たちのオフィス" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">私たちのオフィス</figcaption>
        </figure>
        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/Company-Building-1024x768.jpg" decoding="async" alt="本社ビル" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
