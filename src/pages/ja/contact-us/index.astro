---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "接触 - 中国北部のジャガイモ生産専門家",
  h1: "接触 - 中国北部のジャガイモ生産専門家",
  description: "Martin.Wang",
  canonical: "/ja/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"ja\" href=\"https://dinweys.com/ja/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="ja" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>接触</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>連絡する専門家</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>Martin.Wang</h3>
          <p style="margin-bottom:0.5rem"><strong>住所:</strong> #3 建物, ノースシリコンバレー, Qiaodong地区, Zhangjiakou市, hebei, 中国.</p>
          <p style="margin-bottom:0.5rem"><strong>電話 | whatsapp | wechat:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>メール: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>アーロン.王</h3>
          <p style="margin-bottom:0.5rem"><strong>電話 | whatsapp | wechat:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>メール: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
