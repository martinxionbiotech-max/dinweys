---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "接触",
  h1: "接触",
  description: "马丁",
  canonical: "/zh/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"zh\" href=\"https://dinweys.com/zh/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="zh-CN" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>接触</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>可以联系的专家</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>马丁</h3>
          <p style="margin-bottom:0.5rem"><strong>地址:</strong> #3 建筑, 北硅谷, Qiaodong District, Zhangjiakou City, hebei, 中国.</p>
          <p style="margin-bottom:0.5rem"><strong>电话 | WhatsApp | 微信:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>电子邮件: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>亚伦.王</h3>
          <p style="margin-bottom:0.5rem"><strong>电话 | WhatsApp | 微信:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>电子邮件: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
