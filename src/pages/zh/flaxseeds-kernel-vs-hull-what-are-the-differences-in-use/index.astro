const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "亚麻籽仁和外壳之间的主要营养差异是什么?", "acceptedAnswer": {"@type": "Answer", "text": "回答:亚麻籽仁营养丰富, 富含石油 (尤其是 Omega-3 脂肪酸), 蛋白质, 和木酚素. 相比之下, 亚麻籽壳主要富含膳食纤维，脂肪和蛋白质含量极低. 例如, 每 100 克, 玉米粒含有约 42 克脂肪和 22 克 Omega-3, 而外壳仅含有约 5 克脂肪和不到 1 克 Omega-3.数据来源: 美国农业部营养数据库和《农业与食品化学杂志》的研究"}}, {"@type": "Question", "name": "亚麻籽仁和壳在加工过程中如何分离?", "acceptedAnswer": {"@type": "Answer", "text": "回答:分离过程通常涉及机械破碎以使外壳破裂, 然后进行筛选或风选，将较轻的外壳与较重的谷粒分离. 在某些情况下, 溶剂辅助萃取用于在物理分离之前提高籽粒中的油回收率. 这确保了每种成分保留其独特的营养和功能特性.数据来源: 有关食品加工技术的行业文献"}}, {"@type": "Question", "name": "亚麻籽壳的常见应用有哪些?", "acceptedAnswer": {"@type": "Answer", "text": "回答:亚麻籽壳, 由于纤维含量高, 常被用作饼干等高纤维食品中的膳食纤维补充剂, 能量棒, 和谷物. 它们还可作为低热量或低脂肪产品中的功能性成分，在这些产品中需要增加体积和改善质地. 此外, 一些行业正在探索使用亚麻籽壳生产活性炭和环保材料.数据来源: 食品和工业应用的各种案例研究"}}, {"@type": "Question", "name": "为什么食用去壳亚麻籽仁比食用整粒亚麻籽更有益?", "acceptedAnswer": {"@type": "Answer", "text": "回答:去除外壳可以改善营养吸收，因为体积大, 外壳的不溶性纤维有时会阻碍内核有益脂肪的释放, 蛋白质, 和木酚素. 而且, 去壳的内核提供更光滑的质地和更好的风味, 使它们非常适合烹饪, 烘烤, 或添加到酸奶和燕麦片等食物中. 这也提高了石油开采的效率.数据来源: 美国农业部营养数据库和烹饪最佳实践"}}, {"@type": "Question", "name": "从亚麻籽仁中提取油而不是从整粒亚麻籽中提取油有什么优点?", "acceptedAnswer": {"@type": "Answer", "text": "回答:使用纯亚麻籽仁提取油可提高油产量和纯度. 不含纤维壳材料意味着油不太可能被杂质污染, 提高其氧化稳定性和保质期. 该过程还确保 Omega-3 脂肪酸和木酚素等有益成分更好地保留在最终油产品中.数据来源: 食品加工研究和行业报告"}}]};
const hreflang = "<link rel=\"alternate\" hreflang=\"zh\" href=\"https://dinweys.com/zh/flaxseeds-kernel-vs-hull-what-are-the-differences-in-use/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/flaxseeds-kernel-vs-hull-what-are-the-differences-in-use/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/flaxseeds-kernel-vs-hull-what-are-the-differences-in-use/\" />";
