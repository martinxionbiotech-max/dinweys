---
import ProductLayout from "../../layouts/ProductLayout.astro";

const page = {
  title: "Dinweys Potato Flour (Mashed Potato Flakes)",
  description: "The potato flour uses Atlantic variety potatoes as raw material, with a fineness of 100 mesh. The quality requirements meet those of PepsiCo, with low",
  canonical: "/dinweys-potato-flour-mashed-potato-flakes/",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/dinweys-potato-flour-mashed-potato-flakes/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/dinweys-potato-flour-mashed-potato-flakes/\" />";
const gallery = ["/images/potato-flour-scaled.jpg", "/images/oraginal-mashed-potato1.jpg", "/images/oringal-mashed-potato2.jpg"];
const related = [{"name": "Chinese French Fries Crinkle Cut Manufacturer Direct Bulk Sale", "href": "/chinese-french-fries-crinkle-cut/", "image": "/images/french-fries-crinkle-cut1-2-300x300.jpg"}, {"name": "Dinweys Bulk Potato Flakes", "href": "/dinweys-bulk-potato-flakes/", "image": "/images/Dinweys-Potato-flakes-scaled-300x300.jpg"}, {"name": "1/4 French Fries McCain in Bulk \u2013 Manufacturer Direct", "href": "/1-4-french-fries-mccain-in-bulk-manufacturer-direct/", "image": "/images/21-scaled-300x300.jpg"}, {"name": "Instant Sweet Potatoes Flakes (Snow Flakes) Premium 20kg Bag", "href": "/instant-sweet-potatoes-flakes-snow-flakes-premium-20kg-bag/", "image": "/images/Instant-Sweet-Potatoes-Flakes-2-300x300.jpg"}];
const category = "Potato Series";
const price = "";
---
<ProductLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogImage="/images/potato-flour-1024x1024.jpg" gallery={gallery} category={category} price={price} related={related} descriptionHtml={`<p>The potato flour uses Atlantic variety potatoes as raw material, with a fineness of 100 mesh. The quality requirements meet those of PepsiCo, with low reducing sugars, low free starch, and high purity.</p><div class="wp-video"><video class="wp-video-shortcode" controls="controls" height="640" id="video-536-4" poster="/wp-content/uploads/2024/11/微信图片_2024101109413211.jpg" preload="metadata" width="360"><source src="/images/mashed-potato.mp4" type="video/mp4"/><a>/wp-content/uploads/2024/10/mashed-potato.mp4</a></video></div><h2>Details</h2><h3><strong><b>Microbiological Testing</b></strong></h3><table><thead><tr><th>Test Item</th><th>Unit</th><th>Test Method</th><th>Test Result</th><th>Limit</th><th>Conformity</th></tr></thead><tbody><tr><td>Total Colony Count</td><td>CFU/g</td><td>GB 4789.2-2022</td><td>&lt;10</td><td>10<sup>5</sup></td><td>Conforms</td></tr><tr><td>Shigella</td><td>/25 g</td><td>GB 4789.5-2012</td><td>ND</td><td>0</td><td>Conforms</td></tr><tr><td>Staphylococcus aureus</td><td>/25 g</td><td>GB 4789.10-2016 (Method 1)</td><td>ND</td><td>0</td><td>Conforms</td></tr><tr><td>Salmonella</td><td>/25 g</td><td>GB 4789.4-2016</td><td>ND</td><td>0</td><td>Conforms</td></tr><tr><td>Escherichia coli (E. coli)</td><td>CFU/g</td><td>GB 4789.3-2016 (Method 2)</td><td>&lt;10</td><td>10<sup>3</sup></td><td>Conforms</td></tr></tbody></table><h2>Physicochemical Testing</h2><table><thead><tr><th>Test Item</th><th>Unit</th><th>Test Method</th><th>Detection Limit</th><th>Test Result</th><th>Limit</th><th>Conformity</th></tr></thead><tbody><tr><td>Moisture Content</td><td>%</td><td>GB 5009.3-2016 (Method 1)</td><td>–</td><td>6.13%</td><td>≤9.0%</td><td>Conforms</td></tr><tr><td>Ash Content (Dry Basis)</td><td>%</td><td>GB 5009.4-2016 (Method 1)</td><td>–</td><td>3.0%</td><td>≤4.0%</td><td>Conforms</td></tr><tr><td>Reducing Sugars (as Glucose)</td><td>%</td><td>GB 5009.7-2016 (Method 1)</td><td>0.25</td><td>0.6%</td><td>≤3.0%</td><td>Conforms</td></tr><tr><td>Sulfur Dioxide (SO₂)</td><td>g/kg</td><td>GB 5009.34-2022 (Method 1)</td><td>0.01</td><td>ND</td><td>≤0.03</td><td>Conforms</td></tr><tr><td>Lead (Pb)</td><td>mg/kg</td><td>GB 5009.12-2017 (Method 2)</td><td>0.05</td><td>ND</td><td>≤0.2</td><td>Conforms</td></tr><tr><td>Arsenic (As)</td><td>mg/kg</td><td>GB 5009.11-2014 (Method 2)</td><td>0.040</td><td>ND</td><td>Not detectable</td><td>Conforms</td></tr></tbody></table><h2>Sensory Evaluation</h2><table><thead><tr><th>Test Item</th><th>Standard</th><th>Test Result</th><th>Conformity</th></tr></thead><tbody><tr><td>Color</td><td>SB/T 10752-2012</td><td>Uniform color</td><td>Conforms</td></tr><tr><td>Odor</td><td>SB/T 10752-2012</td><td>The characteristic odor of potato flakes</td><td>Conforms</td></tr><tr><td>Texture</td><td>SB/T 10752-2012</td><td>Dry, loose flake-like form, with no clumping or mildew</td><td>Conforms</td></tr><tr><td>Impurities</td><td>SB/T 10752-2012</td><td>No visible foreign impurities</td><td>Conforms</td></tr></tbody></table>`} />
