---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "About Us",
  h1: "About Us",
  description: "DinWeys is a registered trademark in China of Zhangjiakou Dingwei Biotech Co., Ltd.",
  canonical: "/about-us/",
  author: "",
  date: "",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/about-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/about-us/\" /> <link rel=\"alternate\" hreflang=\"zh\" href=\"https://dinweys.com/zh/about-us/\" /> <link rel=\"alternate\" hreflang=\"zh-tw\" href=\"https://dinweys.com/zh-tw/about-us/\" /> <link rel=\"alternate\" hreflang=\"ar\" href=\"https://dinweys.com/ar/about-us/\" /> <link rel=\"alternate\" hreflang=\"fr\" href=\"https://dinweys.com/fr/about-us/\" /> <link rel=\"alternate\" hreflang=\"de\" href=\"https://dinweys.com/de/about-us/\" /> <link rel=\"alternate\" hreflang=\"it\" href=\"https://dinweys.com/it/about-us/\" /> <link rel=\"alternate\" hreflang=\"ja\" href=\"https://dinweys.com/ja/about-us/\" /> <link rel=\"alternate\" hreflang=\"ko\" href=\"https://dinweys.com/ko/about-us/\" /> <link rel=\"alternate\" hreflang=\"pt\" href=\"https://dinweys.com/pt/about-us/\" /> <link rel=\"alternate\" hreflang=\"ru\" href=\"https://dinweys.com/ru/about-us/\" /> <link rel=\"alternate\" hreflang=\"es\" href=\"https://dinweys.com/es/about-us/\" /> <link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/about-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" ogImage="/images/Food-Factory-1-1024x700.jpg">
    <section class="hero" style="padding:3rem 0">
    <div class="container">
      <h1>About DinWeys</h1>
    </div>
  </section>
  <div class="container">
    <article class="page-content">
      <p><em>DinWeys is a registered trademark in China of Zhangjiakou Dingwei Biotech Co., Ltd.</em></p>
      <p>We have changed our trading name from XION to DinWeys in 2024</p>
      <p><strong>Dinweys Biotech Co., Ltd.</strong> is a manufacturing and service enterprise established as a joint venture by investors from China, New Zealand, and Taiwan. While we offer a diverse range of agricultural solutions, our <strong>core expertise lies in deep-processed potato products</strong>, specifically <strong>Potato Flakes, Frozen French Fries, and Potato Starch</strong>.</p>
      <p>Strategically located in Zhangjiakou City, Hebei Province (160km from Beijing)—a region known for premium agriculture—we also leverage local resources to supply high-quality <strong>flaxseed, quinoa, and oat series</strong>. We utilize advanced processing techniques, including drum drying, freeze-drying, extrusion, and low-temperature processing, to create superior ingredients.</p>
      <p>With an additional operations branch in North Shore, Auckland (New Zealand), we are positioned to serve the global market efficiently. Whether you are a top-tier international brand or a growing SME, we provide stable, reliable, and cost-effective ingredient solutions tailored to your needs.</p>
      <div class="card-grid" style="margin-top:1.5rem">
        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/Food-Factory-1.jpg" decoding="async" alt="Potato Processing Line" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">Potato Processing Line</figcaption>
        </figure>
        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/office-1024x768.jpg" decoding="async" alt="Our Office" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">Our Office</figcaption>
        </figure>
        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/Company-Building-1024x768.jpg" decoding="async" alt="Head office building" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">Head office building</figcaption>
        </figure>
        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/Production-line.jpg" decoding="async" alt="at the production line" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">at the production line</figcaption>
        </figure>
        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/1.jpg" decoding="async" alt="Dr Zia visit" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">Dr Zia visit</figcaption>
        </figure>
        <figure class="card" style="padding:0;overflow:hidden;text-align:center">
          <img src="/images/2-1024x1024.jpg" decoding="async" alt="Solid Partners" loading="lazy" style="width:100%;height:200px;object-fit:cover;border-radius:0" />
          <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">Solid Partners</figcaption>
        </figure>
      </div>
      <figure class="card" style="padding:0;overflow:hidden;text-align:center;margin-top:1.5rem;max-width:520px;margin-left:auto;margin-right:auto">
        <img src="/images/营业执照_001.jpg" decoding="async" alt="DinWeys Business License" loading="lazy" style="width:100%" />
        <figcaption style="padding:0.7rem;color:var(--ink-soft);font-size:0.9rem">DinWeys Business License</figcaption>
      </figure>
      <h2 class="section-title" style="margin-top:2rem"><strong>Company Verification Statement </strong></h2>
      <p><strong>Company Name:</strong> Zhangjiakou Dingwei Biotechnology Co., Ltd.<br/><strong>Unified Social Credit Code (Business License Number):</strong> 91130702MADY9DX57U<br/><strong>Customs Registration Number:</strong> 1307961A3J<br/><strong>Registered in:</strong> Zhangjiakou City, Hebei Province, China</p>
      <ul>
        <li><a href="https://www.gsxt.gov.cn" rel="nofollow noopener" target="_blank">National Enterprise Credit Information Publicity System (China)</a></li>
        <li><a href="https://www.qcc.com" rel="nofollow noopener" target="_blank">Qichacha (Chinese Business Database)</a></li>
        <li><a href="https://www.registerchina.com" rel="nofollow noopener" target="_blank">RegisterChina.com</a></li>
      </ul>
      <p>We are a legally registered and operating biotechnology company in China. You may verify our business registration through official and trusted third-party platforms:</p>
      <p>Our company adheres to all applicable laws and regulations in China and maintains a transparent corporate structure. If you require further verification, we are happy to provide additional documentation such as a scanned business license, tax certificate, customs registration proof, or third-party audit reports.</p>
      <p>Please feel free to contact us for any business verification needs.</p>
      <p style="margin-top:2rem"><a href="https://dotheygobad.com/" rel="nofollow noopener" target="_blank">Tech Mange Martin’s Blog supported by Our Team </a></p>
    </article>
  </div>

</BaseLayout>
