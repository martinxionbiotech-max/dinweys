---
import BaseLayout from "../../layouts/BaseLayout.astro";

const page = {
  title: "About Us",
  h1: "About Us",
  description: "DinWeys is a registered trademark in China of Zhangjiakou Dingwei Biotech Co., Ltd.",
  canonical: "/about-us/",
  author: "",
  date: "",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/about-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/about-us/\" /> <link rel=\"alternate\" hreflang=\"zh\" href=\"https://dinweys.com/zh/about-us/\" /> <link rel=\"alternate\" hreflang=\"zh-tw\" href=\"https://dinweys.com/zh-tw/about-us/\" /> <link rel=\"alternate\" hreflang=\"ar\" href=\"https://dinweys.com/ar/about-us/\" /> <link rel=\"alternate\" hreflang=\"fr\" href=\"https://dinweys.com/fr/about-us/\" /> <link rel=\"alternate\" hreflang=\"de\" href=\"https://dinweys.com/de/about-us/\" /> <link rel=\"alternate\" hreflang=\"it\" href=\"https://dinweys.com/it/about-us/\" /> <link rel=\"alternate\" hreflang=\"ja\" href=\"https://dinweys.com/ja/about-us/\" /> <link rel=\"alternate\" hreflang=\"ko\" href=\"https://dinweys.com/ko/about-us/\" /> <link rel=\"alternate\" hreflang=\"pt\" href=\"https://dinweys.com/pt/about-us/\" /> <link rel=\"alternate\" hreflang=\"ru\" href=\"https://dinweys.com/ru/about-us/\" /> <link rel=\"alternate\" hreflang=\"es\" href=\"https://dinweys.com/es/about-us/\" /> <link rel=\"alternate\" hreflang=\"th\" href=\"https://dinweys.com/th/about-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" ogImage="/images/Food-Factory-1-1024x700.jpg">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<h2 class="wp-block-heading has-text-align-center" id="h-about-dinweys">About DinWeys</h2><p class="has-text-align-center wp-block-paragraph"><em>DinWeys is a registered trademark in China of Zhangjiakou Dingwei Biotech Co., Ltd.</em></p><p class="has-text-align-center has-contrast-2-color has-text-color has-link-color wp-elements-2 wp-block-paragraph">We have changed our trading name from XION to DinWeys in 2024</p><div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex"><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><div class="wp-block-image is-style-rounded"><figure class="aligncenter size-full is-resized"><img src="/images/Food-Factory-1.jpg" decoding="async" width="2090" height="1428" alt="Potato Flakes | Frozen French Fries | Potato Starch | Others" class="wp-image-287" style="object-fit:cover;width:338px;height:300px" title="About Us 8" /><figcaption class="wp-element-caption">Potato Processing Line</figcaption></figure></div></div><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><div class="wp-block-image is-style-rounded"><figure class="aligncenter size-large is-resized"><img src="/images/office-1024x768.jpg" decoding="async" width="1024" height="768" alt="Potato Flakes | Frozen French Fries | Potato Starch | Others" class="wp-image-238" style="object-fit:cover;width:339px;height:300px" title="About Us 9" /><figcaption class="wp-element-caption">Our Office</figcaption></figure></div></div><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><div class="wp-block-image is-style-rounded"><figure class="aligncenter size-large is-resized"><img src="/images/Company-Building-1024x768.jpg" decoding="async" width="1024" height="768" alt="Potato Flakes | Frozen French Fries | Potato Starch | Others" class="wp-image-208" style="object-fit:cover;width:339px;height:300px" title="About Us 10" /><figcaption class="wp-element-caption">Head office building</figcaption></figure></div></div></div><div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex"><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><div class="wp-block-image is-style-rounded"><figure class="aligncenter size-full is-resized"><img src="/images/Production-line.jpg" decoding="async" width="1706" height="1279" alt="Potato Flakes | Frozen French Fries | Potato Starch | Others" class="wp-image-240" style="object-fit:cover;width:360px;height:300px" title="About Us 11" /><figcaption class="wp-element-caption">at the production line</figcaption></figure></div></div><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><div class="wp-block-image is-style-rounded"><figure class="aligncenter size-full is-resized"><img src="/images/1.jpg" decoding="async" width="723" height="723" alt="Potato Flakes | Frozen French Fries | Potato Starch | Others" class="wp-image-248" style="object-fit:cover;width:273px;height:300px" title="About Us 12" /><figcaption class="wp-element-caption">Dr Zia visit</figcaption></figure></div></div><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><div class="wp-block-image is-style-rounded"><figure class="aligncenter size-large is-resized"><img src="/images/2-1024x1024.jpg" decoding="async" width="1024" height="1024" alt="Potato Flakes | Frozen French Fries | Potato Starch | Others" class="wp-image-249" style="object-fit:cover;width:267px;height:300px" title="About Us 13" /><figcaption class="wp-element-caption">Solid Partners</figcaption></figure></div></div></div><div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex"><div class="wp-block-column is-layout-flow wp-block-column-is-layout-flow"><p class="has-medium-font-size wp-block-paragraph"><strong>Dinweys Biotech Co., Ltd.</strong> is a manufacturing and service enterprise established as a joint venture by investors from China, New Zealand, and Taiwan. While we offer a diverse range of agricultural solutions, our <strong>core expertise lies in deep-processed potato products</strong>, specifically <strong>Potato Flakes, Frozen French Fries, and Potato Starch</strong>.</p><p class="has-medium-font-size wp-block-paragraph">Strategically located in Zhangjiakou City, Hebei Province (160km from Beijing)—a region known for premium agriculture—we also leverage local resources to supply high-quality <strong>flaxseed, quinoa, and oat series</strong>. We utilize advanced processing techniques, including drum drying, freeze-drying, extrusion, and low-temperature processing, to create superior ingredients.</p><p class="has-medium-font-size wp-block-paragraph">With an additional operations branch in North Shore, Auckland (New Zealand), we are positioned to serve the global market efficiently. Whether you are a top-tier international brand or a growing SME, we provide stable, reliable, and cost-effective ingredient solutions tailored to your needs.</p></div></div><div class="wp-block-image"><figure class="aligncenter size-full is-resized"><img src="/images/营业执照_001.jpg" decoding="async" alt="Potato Flakes | Frozen French Fries | Potato Starch | Others" class="wp-image-233" style="width:400px" title="About Us 14" width="7016" height="4960" /><figcaption class="wp-element-caption">DinWeys Business License</figcaption></figure></div><div class="wp-block-columns is-layout-flex wp-container-core-columns-is-layout-8f761849 wp-block-columns-is-layout-flex"><div class="wp-block-column has-medium-font-size is-layout-flow wp-block-column-is-layout-flow"><h2 class="wp-block-heading"><strong>Company Verification Statement </strong></h2><p class="wp-block-paragraph"><strong>Company Name:</strong> Zhangjiakou Dingwei Biotechnology Co., Ltd.<br><strong>Unified Social Credit Code (Business License Number):</strong> 91130702MADY9DX57U<br><strong>Customs Registration Number:</strong> 1307961A3J<br><strong>Registered in:</strong> Zhangjiakou City, Hebei Province, China</p><p class="wp-block-paragraph">We are a legally registered and operating biotechnology company in China. You may verify our business registration through official and trusted third-party platforms:</p><ul class="wp-block-list"><li><a class="" href="https://www.gsxt.gov.cn" rel="nofollow noopener" target="_blank">National Enterprise Credit Information Publicity System (China)</a></li><li><a class="" href="https://www.qcc.com" rel="nofollow noopener" target="_blank">Qichacha (Chinese Business Database)</a></li><li><a class="" href="https://www.registerchina.com" rel="nofollow noopener" target="_blank">RegisterChina.com</a> <em>(Unofficial, for reference only)</em></li></ul><p class="wp-block-paragraph">Our company adheres to all applicable laws and regulations in China and maintains a transparent corporate structure. If you require further verification, we are happy to provide additional documentation such as a scanned business license, tax certificate, customs registration proof, or third-party audit reports.</p><p class="wp-block-paragraph">Please feel free to contact us for any business verification needs.</p></div></div><p class="has-small-font-size wp-block-paragraph"><a href="https://dotheygobad.com/" rel="nofollow noopener" target="_blank">Tech Mange Martin&#8217;s Blog supported by Our Team </a></p>`} />
  </article>
</BaseLayout>
