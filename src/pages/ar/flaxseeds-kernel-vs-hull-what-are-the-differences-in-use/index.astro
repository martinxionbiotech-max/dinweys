const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "ما هي الاختلافات الغذائية الرئيسية بين حبات بذور الكتان والقشور?", "acceptedAnswer": {"@type": "Answer", "text": "إجابة:حبات بذور الكتان كثيفة المغذيات, غنية بالنفط (وخاصة أحماض أوميغا 3 الدهنية), بروتين, والقشور. في المقابل, تحتوي قشر بذور الكتان في الغالب على نسبة عالية من الألياف الغذائية مع كميات منخفضة جدًا من الدهون والبروتينات. على سبيل المثال, لكل 100 غرام, تحتوي الحبات على حوالي 42 جرامًا من الدهون و22 جرامًا من أوميغا 3, بينما تحتوي القشرة على حوالي 5 جرام فقط من الدهون وأقل من 1 جرام من أوميغا 3.مصدر البيانات: قاعدة بيانات وأبحاث المغذيات التابعة لوزارة الزراعة الأمريكية من مجلة الكيمياء الزراعية والغذائية"}}, {"@type": "Question", "name": "كيف يتم فصل حبات وقشر بذور الكتان أثناء المعالجة?", "acceptedAnswer": {"@type": "Answer", "text": "إجابة:تتضمن عملية الفصل عادةً التكسير الميكانيكي لتكسير الغلاف الخارجي, يليه الغربلة أو تصنيف الهواء لفصل الهياكل الأخف عن الحبات الأثقل. في بعض الحالات, يتم استخدام الاستخلاص بمساعدة المذيبات لتحسين استخلاص الزيت من الحبوب قبل الفصل المادي. وهذا يضمن أن كل مكون يحتفظ بخصائصه الغذائية والوظيفية المميزة.مصدر البيانات: الأدب الصناعي حول تقنيات تجهيز الأغذية"}}, {"@type": "Question", "name": "ما هي التطبيقات الشائعة لقشر بذور الكتان?", "acceptedAnswer": {"@type": "Answer", "text": "إجابة:قشر بذور الكتان, بسبب محتواها العالي من الألياف, غالبًا ما تستخدم كمكملات ألياف غذائية في الأطعمة الغنية بالألياف مثل ملفات تعريف الارتباط, قضبان الطاقة, والحبوب. كما أنها بمثابة مكونات وظيفية في المنتجات منخفضة السعرات الحرارية أو قليلة الدسم حيث تكون هناك حاجة إلى كميات كبيرة وملمس محسن. بالإضافة إلى ذلك, تستكشف بعض الصناعات استخدام قشور بذور الكتان في إنتاج الكربون المنشط والمواد الصديقة للبيئة.مصدر البيانات: دراسات حالة مختلفة في التطبيقات الغذائية والصناعية"}}, {"@type": "Question", "name": "لماذا يعد استهلاك بذور الكتان المقشرة أكثر فائدة من استهلاك بذور الكتان الكاملة؟?", "acceptedAnswer": {"@type": "Answer", "text": "إجابة:تؤدي إزالة الهيكل إلى تحسين امتصاص العناصر الغذائية نظرًا لضخامة حجمها, يمكن أن تعيق ألياف الهيكل غير القابلة للذوبان في بعض الأحيان إطلاق الدهون المفيدة في النواة, البروتينات, والقشور. علاوة على ذلك, توفر الحبات المقشرة ملمسًا أكثر نعومة ونكهة أفضل, مما يجعلها مثالية للطهي, الخبز, أو إضافته إلى الأطعمة مثل الزبادي ودقيق الشوفان. وهذا يعزز أيضا كفاءة استخراج النفط.مصدر البيانات: قاعدة بيانات المغذيات التابعة لوزارة الزراعة الأمريكية وأفضل ممارسات الطهي"}}, {"@type": "Question", "name": "ما هي مميزات استخلاص الزيت من حبات بذور الكتان بدلاً من بذور الكتان الكاملة؟?", "acceptedAnswer": {"@type": "Answer", "text": "إجابة:يؤدي استخدام حبات بذور الكتان النقية لاستخراج الزيت إلى زيادة إنتاجية الزيت ونقائه. إن عدم وجود مادة ليفية للهيكل يعني أن الزيت أقل عرضة للتلوث بالشوائب, مما يحسن استقراره التأكسدي ومدة صلاحيته. تضمن العملية أيضًا الحفاظ على المكونات المفيدة مثل أحماض أوميجا 3 الدهنية والقشور بشكل أفضل في المنتج الزيتي النهائي.مصدر البيانات: أبحاث تجهيز الأغذية وتقارير الصناعة"}}]};
