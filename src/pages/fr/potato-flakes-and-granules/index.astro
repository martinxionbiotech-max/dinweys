const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Quelle est la différence entre les flocons de pomme de terre et les granulés?", "acceptedAnswer": {"@type": "Answer", "text": "Les flocons de pomme de terre ressemblent à des feuilles et sont partiellement gélatinisés, idéal comme ingrédient pour les snacks et les produits composites. Les granules sont entièrement gélatinisés, plus petit, et plus lisse, convient aux purées de pommes de terre instantanées."}}, {"@type": "Question", "name": "Quel produit est le meilleur pour les plats de purée de pommes de terre?", "acceptedAnswer": {"@type": "Answer", "text": "Les granulés de pommes de terre sont préférés pour les plats de purée de pommes de terre car ils sont entièrement cuits et produisent une texture plus crémeuse une fois réhydratés.."}}, {"@type": "Question", "name": "Les flocons de pomme de terre peuvent-ils être utilisés directement pour la consommation?", "acceptedAnswer": {"@type": "Answer", "text": "Les flocons de pomme de terre ne sont généralement pas entièrement cuits et sont conçus pour être utilisés comme ingrédients lors d'une transformation ultérieure., plutôt que pour la consommation directe."}}, {"@type": "Question", "name": "Comment les flocons et les granulés de pomme de terre sont-ils traités différemment?", "acceptedAnswer": {"@type": "Answer", "text": "Les deux produits partagent des étapes de traitement similaires, mais les flocons sont séchés au tambour pour produire des flocons en forme de feuille, alors que les granulés sont séchés/agglomérés pour produire de petits, particules uniformes."}}, {"@type": "Question", "name": "Quelles sont les principales applications des flocons de pomme de terre?", "acceptedAnswer": {"@type": "Answer", "text": "Les flocons de pomme de terre sont utilisés dans les collations, produits de boulangerie, mélanges composites, et comme ingrédients fonctionnels pour la liaison de l'eau et la modification de la texture."}}, {"@type": "Question", "name": "Quelles sont les principales applications des granulés de pomme de terre?", "acceptedAnswer": {"@type": "Answer", "text": "Les granulés de pommes de terre sont utilisés dans la purée de pommes de terre instantanée, soupes, plats cuisinés, et autres produits nécessitant une douceur, texture crémeuse."}}]};
