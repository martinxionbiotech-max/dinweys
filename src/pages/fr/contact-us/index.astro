---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Contact - Expert en production de pommes de terre dans le nord de la Chine",
  h1: "Contact - Expert en production de pommes de terre dans le nord de la Chine",
  description: "Martin.Wang",
  canonical: "/fr/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"fr\" href=\"https://dinweys.com/fr/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="fr" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>CONTACT</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>Spécialistes à contacter</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>Martin.Wang</h3>
          <p style="margin-bottom:0.5rem"><strong>Adresse:</strong> #3 bâtiment, Nord de la Silicon Valley, District de Qiaodong, Ville de Zhangjiakou, Hebei, Chine.</p>
          <p style="margin-bottom:0.5rem"><strong>Téléphone | WhatsApp | WeChat:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>E-mail: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>Aaron.Wang</h3>
          <p style="margin-bottom:0.5rem"><strong>Téléphone | WhatsApp | WeChat:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>E-mail: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
