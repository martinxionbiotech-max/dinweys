---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "Beans - 중국 북부 감자 생산 전문가",
  h1: "Beans - 중국 북부 감자 생산 전문가",
  description: "팥, 잠두 등 중국 북부산 프리미엄 콩류를 Dinweys에서 벌크로 공급합니다. OEM 포장 지원, 수입업체 및 식품 제조사 대상.",
  canonical: "/ko/beans/",
  author: " ",
  date: "2024-10-05",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"ko\" href=\"https://dinweys.com/ko/beans/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/beans/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/beans/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="ko" author=" "  datePublished="2024-10-05" dateModified="2024-10-05">
  <article class="page-content">
    <h1 class="page-title">{page.h1}</h1>
    <div class="entry-content" set:html={`<p></p>`} />
  </article>
</BaseLayout>
