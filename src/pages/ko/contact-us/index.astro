---
import BaseLayout from "../../../layouts/BaseLayout.astro";

const page = {
  title: "연락하다 - 중국 북부 감자 생산 전문가",
  h1: "연락하다 - 중국 북부 감자 생산 전문가",
  description: "마틴",
  canonical: "/ko/contact-us/",
  author: " ",
  date: "2024-09-02",
};
const hreflang = "<link rel=\"alternate\" hreflang=\"ko\" href=\"https://dinweys.com/ko/contact-us/\" /> <link rel=\"alternate\" hreflang=\"en\" href=\"https://dinweys.com/contact-us/\" /> <link rel=\"alternate\" hreflang=\"x-default\" href=\"https://dinweys.com/contact-us/\" />";
---
<BaseLayout title={page.title} hreflang={hreflang} description={page.description} canonical={page.canonical} ogType="website" lang="ko" ogImage="/images/company-building-1.jpg" author=" "  datePublished="2024-09-02" dateModified="2024-09-02">
    <section class="hero" style="padding:3rem 0 4rem">
    <div class="container">
      <h1><strong>연락하다</strong></h1>
    </div>
  </section>
  <div class="container" style="margin-top:3rem">
    <article class="page-content">
      <img src="/images/company-building-1-1024x598.jpg" decoding="async" alt="Company Building" style="width:100%;max-width:575px;border-radius:var(--radius)" />
      <h2 class="section-title" style="margin-top:2rem"><strong>연락 할 전문가</strong></h2>
      <div class="card-grid" style="margin-top:1rem">
        <div class="card">
          <h3>마틴</h3>
          <p style="margin-bottom:0.5rem"><strong>주소:</strong> #3 건물, 노스 실리콘 밸리, 차오둥구, 장자커우시, 헤베이, 중국.</p>
          <p style="margin-bottom:0.5rem"><strong>핸드폰 | 왓츠앱 | 위챗:</strong> +86 13323237275</p>
          <p style="margin-bottom:0.5rem"><strong>이메일: </strong><a href="mailto:martin@dinweys.com">martin@dinweys.com</a></p>
        </div>
        <div class="card">
          <h3>아론.왕</h3>
          <p style="margin-bottom:0.5rem"><strong>핸드폰 | 왓츠앱 | 위챗:</strong> +86 13313137465</p>
          <p style="margin-bottom:0.5rem"><strong>이메일: </strong><a href="mailto:aaron@dinweys.com">aaron@dinweys.com</a></p>
        </div>
      </div>
    </article>
  </div>

</BaseLayout>
