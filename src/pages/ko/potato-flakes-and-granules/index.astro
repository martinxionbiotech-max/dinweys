const faqJson = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "What is the difference between potato flakes and granules?", "acceptedAnswer": {"@type": "Answer", "text": "Potato flakes are sheet-like and partially gelatinized, ideal as ingredient for snacks and composite products. Granules are fully gelatinized, smaller, and smoother, suitable for instant mashed potato products."}}, {"@type": "Question", "name": "Which product is better for mashed potato dishes?", "acceptedAnswer": {"@type": "Answer", "text": "Potato granules are preferred for mashed potato dishes because they are fully cooked and produce a creamier texture when rehydrated."}}, {"@type": "Question", "name": "Can potato flakes be used directly for consumption?", "acceptedAnswer": {"@type": "Answer", "text": "Potato flakes are generally not fully cooked and are designed to be used as ingredients in further processing, rather than for direct consumption."}}, {"@type": "Question", "name": "How are potato flakes and granules processed differently?", "acceptedAnswer": {"@type": "Answer", "text": "Both products share similar processing steps, but flakes are drum-dried to produce sheet-like flakes, whereas granules are dried/agglomerated to produce small, uniform particles."}}, {"@type": "Question", "name": "What are the main applications of potato flakes?", "acceptedAnswer": {"@type": "Answer", "text": "Potato flakes are used in snacks, bakery products, composite mixes, and as functional ingredients for water binding and texture modification."}}, {"@type": "Question", "name": "What are the main applications of potato granules?", "acceptedAnswer": {"@type": "Answer", "text": "Potato granules are used in instant mashed potatoes, 수프, ready meals, and other products requiring a smooth, creamy texture."}}]};
