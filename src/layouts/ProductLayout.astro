---
import BaseLayout from "./BaseLayout.astro";

interface RelatedProduct {
  name: string;
  href: string;
  image?: string;
}

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  gallery: string[];           // 画廊图片 src 列表
  category?: string;            // 分类名
  price?: string;               // 价格（可能为空）
  descriptionHtml: string;      // 清洗后的描述正文 HTML
  related?: RelatedProduct[];
  hreflang?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  gallery = [],
  category,
  price,
  descriptionHtml,
  related = [],
  hreflang,
} = Astro.props;

const featured = gallery[0] ?? ogImage ?? "/images/logo2.png";
---

<BaseLayout title={title} hreflang={hreflang} description={description} canonical={canonical} ogType="product" ogImage={ogImage ?? featured}>
  <div class="container product-shell">
    <nav class="crumblist" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/products/">Products</a>
      {category && (
        <>
          <span aria-hidden="true">›</span>
          <span class="crumb-current">{category}</span>
        </>
      )}
    </nav>

    <div class="product-grid">
      <div class="product-gallery">
        {gallery.length > 0 ? (
          gallery.map((src) => (
            <figure class="gallery-item">
              <img src={src} alt={title} loading={gallery.indexOf(src) === 0 ? "eager" : "lazy"} />
            </figure>
          ))
        ) : (
          <figure class="gallery-item">
            <img src={featured} alt={title} />
          </figure>
        )}
      </div>

      <div class="product-summary">
        <h1 class="product-title">{title}</h1>
        {category && <p class="product-cat">Category: <a href="/products/">{category}</a></p>}
        {price && <p class="product-price">{price}</p>}
        <div class="product-actions">
          <a class="btn" href="/contact-us/">Request a Quote</a>
          <a class="btn outline" href="mailto:martin@dinweys.com">Email Us</a>
        </div>
      </div>
    </div>

    <div class="product-desc" set:html={descriptionHtml} />

    {related.length > 0 && (
      <section class="related">
        <h2 class="section-title">Related Products</h2>
        <div class="related-grid">
          {related.map((p) => (
            <a class="related-card" href={p.href}>
              {p.image && <img src={p.image} alt={p.name} loading="lazy" />}
              <span class="related-name">{p.name}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .product-shell { padding-top: 2rem; padding-bottom: 4rem; }

  .crumblist {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }
  .crumblist a { color: var(--ink-muted); text-decoration: none; }
  .crumblist a:hover { color: var(--primary); }
  .crumb-current { color: var(--ink-soft); font-weight: 500; }

  .product-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 3rem;
    align-items: start;
  }

  .product-gallery { display: flex; flex-direction: column; gap: 1rem; }
  .gallery-item { margin: 0; }
  .gallery-item img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-alt);
  }

  .product-summary { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 5.5rem; }
  .product-title {
    margin: 0;
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }
  .product-cat { margin: 0; color: var(--ink-muted); font-size: 0.95rem; }
  .product-cat a { color: var(--primary); }
  .product-price { margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--primary); }
  .product-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 0.5rem; }

  .product-desc { margin-top: 3rem; font-size: 1.02rem; }
  .product-desc h2, .product-desc h3 { margin-top: 2rem; }
  .product-desc table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .product-desc table th {
    background: var(--bg-alt);
    text-align: left;
    font-weight: 600;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
  }
  .product-desc table td {
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
  }

  .related { margin-top: 3.5rem; }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .related-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .related-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 6px;
  }
  .related-name { font-size: 0.9rem; font-weight: 500; line-height: 1.4; }

  @media (max-width: 820px) {
    .product-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .product-summary { position: static; }
  }
</style>
