---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  gallery?: string[];
  category?: string;
  price?: string;
  related?: { name: string; href: string; image: string }[];
  descriptionHtml?: string;
  hreflang?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  gallery = [],
  category = "",
  price = "",
  related = [],
  descriptionHtml = "",
  hreflang,
} = Astro.props;

const mainImage = gallery[0] || ogImage;
---

<BaseLayout title={title} hreflang={hreflang} description={description} canonical={canonical} ogType="product" ogImage={mainImage}>
  <div class="container product-shell">
    <nav class="crumblist" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/products/">Products</a>
      <span aria-hidden="true">›</span>
      <span class="crumb-current">{title}</span>
    </nav>

    <div class="product-grid">
      <div class="product-gallery">
        <div class="g-main">
          {mainImage ? (
            <img src={mainImage} alt={title} width="600" height="600" loading="eager" />
          ) : (
            <div class="g-placeholder">No image</div>
          )}
        </div>
      </div>

      <div class="product-info">
        {category && <span class="product-cat">{category}</span>}
        <h1 class="product-title">{title}</h1>
        {price && <p class="product-price">{price}</p>}
        <div class="product-desc" set:html={descriptionHtml} />
        <div class="product-cta">
          <a class="btn" href="/contact-us/">Request a Quote</a>
          <a class="btn outline" href="/products/">Browse All Products</a>
        </div>
      </div>
    </div>

    {related.length > 0 && (
      <section class="section" style="padding-top:3rem">
        <span class="kicker">You may also like</span>
        <h2 class="sec-title">Related Products</h2>
        <div class="card-grid">
          {related.map((r) => (
            <div class="card">
              {r.image && (
                <div class="thumb">
                  <img src={r.image} alt={r.name} loading="lazy" />
                </div>
              )}
              <div class="body">
                <h3><a href={r.href}>{r.name}</a></h3>
                <a class="link" href={r.href}>View product →</a>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .product-info .product-price {
    font-size: 1.6rem; font-weight: 800; color: var(--primary); margin: 0.4rem 0 1rem;
  }
  .g-placeholder {
    color: var(--ink-muted); font-size: 0.9rem;
    display: flex; align-items: center; justify-content: center; height: 100%;
  }
</style>
