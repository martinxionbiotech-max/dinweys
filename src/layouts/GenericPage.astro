---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  bodyHtml: string;
  hreflang?: string;
}

const { title, description, canonical, ogImage, bodyHtml, hreflang } = Astro.props;
---

<BaseLayout title={title} hreflang={hreflang} description={description} canonical={canonical} ogType="website" ogImage={ogImage}>
  <div class="container page-shell">
    <h1 class="page-heading">{title}</h1>
    <div class="page-body" set:html={bodyHtml} />
  </div>
</BaseLayout>

<style>
  .page-shell { max-width: 820px; padding-top: 2.5rem; padding-bottom: 4rem; }
  .page-heading {
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1.2;
    margin: 0 0 2rem;
    letter-spacing: -0.02em;
  }
  .page-body { font-size: 1.02rem; }
  .page-body h2 {
    margin-top: 2.2rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--border);
  }
  .page-body h3 { margin-top: 1.6rem; }
</style>
