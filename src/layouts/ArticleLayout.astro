---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  author?: string;
  date?: string;
  ogImage?: string;
  bodyHtml: string; // 清洗后的干净正文 HTML
  breadcrumbLabel?: string;
  hreflang?: string;
}

const {
  title,
  description,
  canonical,
  author = "Dinweys Team",
  date,
  ogImage,
  bodyHtml,
  breadcrumbLabel = "Blog",
  hreflang,
} = Astro.props;

// 格式化日期
const fmtDate = date
  ? new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : null;
---

<BaseLayout title={title} hreflang={hreflang} description={description} canonical={canonical} ogType="article" ogImage={ogImage} author={author} datePublished={date} dateModified={date}>
  <div class="container article-shell">
    <nav class="crumblist" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span aria-hidden="true">›</span>
      <a href="/blog/">Blog</a>
      <span aria-hidden="true">›</span>
      <span class="crumb-current">{title}</span>
    </nav>

    <article class="post">
      <header class="post-header">
        <h1 class="post-title">{title}</h1>
        {fmtDate && (
          <div class="post-meta">
            {(author && (
              <span class="post-author">By <strong>{author}</strong></span>
            ))}
            {fmtDate && <span class="post-date">{fmtDate}</span>}
          </div>
        )}
      </header>

      <div class="post-body" set:html={bodyHtml} />

      <footer class="post-cta">
        <p>Looking for premium <strong>potato flakes, frozen fries, or starches</strong>? Talk to our team for samples, COA, and tailored bulk quotes.</p>
        <a class="btn" href="/contact-us/">Get a Quote</a>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .article-shell { max-width: 820px; padding-top: 2rem; padding-bottom: 4rem; }

  .crumblist {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--ink-muted);
    margin-bottom: 2rem;
  }
  .crumblist a { color: var(--ink-muted); text-decoration: none; }
  .crumblist a:hover { color: var(--primary); }
  .crumb-current { color: var(--ink-soft); font-weight: 500; }

  .post-header { margin-bottom: 2rem; }
  .post-title {
    font-size: clamp(1.9rem, 4vw, 2.5rem);
    line-height: 1.2;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    color: var(--ink-muted);
    font-size: 0.92rem;
  }
  .post-author strong { color: var(--ink-soft); }

  .post-body { font-size: 1.02rem; }

  .post-cta {
    margin-top: 3rem;
    padding: 1.75rem;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius);
  }
  .post-cta p { margin: 0 0 1rem; color: var(--ink-soft); }
</style>
